{
  "id": "/dashboard",
  "name": "Study Planner AI",
  "short_name": "StudyPlanner",
  "description": "AI-powered study planner and CBT exam simulator for JEE, NEET, UPSC, GATE, CAT, CUET, SSC & Banking \u2014 tasks, notes, goals, timetable, attendance, and an AI tutor.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "browser"
  ],
  "background_color": "#F5F7FA",
  "theme_color": "#2F4B7C",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/static/icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/static/screenshots/01-dashboard.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard \u2014 subjects, tasks, and study stats at a glance"
    },
    {
      "src": "/static/screenshots/02-mock-test.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "AI CBT Exam Simulator \u2014 JEE, NEET, UPSC, GATE, CAT, CUET, SSC & Banking"
    },
    {
      "src": "/static/screenshots/03-ai-tutor.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "AI Personal Tutor \u2014 ask anything about your studies"
    },
    {
      "src": "/static/screenshots/04-planner.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Study Planner \u2014 plan and track topics by subject"
    }
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "AI Mock Test",
      "short_name": "Mock Test",
      "description": "Start a full-length CBT mock test",
      "url": "/ai-mock-test",
      "icons": [
        {
          "src": "/static/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "AI Tutor",
      "short_name": "AI Tutor",
      "description": "Ask the AI Tutor a question",
      "url": "/ai-tutor",
      "icons": [
        {
          "src": "/static/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Study Planner",
      "short_name": "Planner",
      "description": "Open today's planner",
      "url": "/planner",
      "icons": [
        {
          "src": "/static/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "related_applications": [],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "/notes"
  },
  "protocol_handlers": [
    {
      "protocol": "web+studyplanner",
      "url": "/dashboard?ref=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/ai-pdf",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}